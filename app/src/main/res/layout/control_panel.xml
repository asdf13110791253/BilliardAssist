<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="16dp">

    <!-- 顶部可折叠工具栏 (只有工具条带一点点半透明底，方便看清图标) -->
    <LinearLayout
        android:id="@+id/top_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="6dp 12dp"
        android:background="#30FFFFFF"
        android:layout_marginBottom="20dp"
        android:elevation="4dp">

        <TextView android:id="@+id/btn_toggle_toolbar" android:text="◀" android:textColor="#444" android:textSize="20sp" android:paddingEnd="12dp"/>
        <View android:layout_width="1dp" android:layout_height="16dp" android:background="#55000000"/>
        <TextView android:text="👁" android:textColor="#444" android:textSize="18sp" android:padding="6dp"/>
    </LinearLayout>

    <!-- 方向键网格 (3列6行，按键保持完全不透明) -->
    <GridLayout
        android:id="@+id/dpad_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_toolbar"
        android:layout_centerHorizontal="true"
        android:rowCount="6"
        android:columnCount="3"
        android:alignmentMode="alignMargins">

        <!-- 第1行：↑ ↓ 并排 -->
        <Space android:layout_row="0" android:layout_column="0" android:layout_width="48dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btn_up" android:text="↑" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="0" android:layout_column="1" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn_down" android:text="↓" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="0" android:layout_column="2" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>

        <!-- 第3行：→ 空 → -->
        <Button android:id="@+id/btn_right1" android:text="→" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="1" android:layout_column="0" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>
        <Space android:layout_row="1" android:layout_column="1" android:layout_width="48dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btn_right2" android:text="→" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="1" android:layout_column="2" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>

        <!-- 第4行：← 空 ← -->
        <Button android:id="@+id/btn_left1" android:text="←" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="2" android:layout_column="0" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>
        <Space android:layout_row="2" android:layout_column="1" android:layout_width="48dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btn_left2" android:text="←" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="2" android:layout_column="2" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>

        <!-- 第6行：↑ ↓ 并排 -->
        <Space android:layout_row="3" android:layout_column="0" android:layout_width="48dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btn_up2" android:text="↑" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="3" android:layout_column="1" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>
        <Button android:id="@+id/btn_down2" android:text="↓" android:backgroundTint="#777" android:textColor="#FFF" android:textSize="22sp" android:layout_row="3" android:layout_column="2" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="4dp"/>

        <!-- 第7行：保存按钮 -->
        <Space android:layout_row="4" android:layout_column="0" android:layout_width="48dp" android:layout_height="0dp"/>
        <Button android:id="@+id/btn_save" android:text="保 存" android:backgroundTint="#FFF" android:textColor="#444" android:textSize="16sp" android:textStyle="bold" android:layout_row="4" android:layout_column="1" android:layout_width="80dp" android:layout_height="40dp" android:layout_margin="4dp"/>
        <Space android:layout_row="4" android:layout_column="2" android:layout_width="48dp" android:layout_height="0dp"/>
    </GridLayout>

    <!-- 右下角拖拽柄 -->
    <TextView
        android:id="@+id/resize_handle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:text="◢"
        android:textSize="18sp"
        android:textColor="#88000000"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="-8dp" />
</RelativeLayout>
