<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D3311"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ 设置"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- 当前桌布 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前桌布："
            android:textColor="#FFD4A017"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_table_cloth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_cloth_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="桌布1"
                android:textColor="#FFFFFFFF"
                android:buttonTint="#FFD4A017" />

            <RadioButton
                android:id="@+id/rb_cloth_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="桌布2"
                android:textColor="#FFFFFFFF"
                android:buttonTint="#FFD4A017" />

            <RadioButton
                android:id="@+id/rb_cloth_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="桌布3"
                android:textColor="#FFFFFFFF"
                android:buttonTint="#FFD4A017" />
        </RadioGroup>

        <!-- 当前反射方案 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前反射方案："
            android:textColor="#FFD4A017"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_reflect_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_compensation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="反射补偿"
                android:textColor="#FFFFFFFF"
                android:buttonTint="#FFD4A017"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_mirror"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="镜像反射"
                android:textColor="#FFFFFFFF"
                android:buttonTint="#FFD4A017" />
        </RadioGroup>

        <!-- 补偿比例 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="补偿比例"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seek_comp_ratio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="18"
                android:progressTint="#FFD4A017" />

            <TextView
                android:id="@+id/tv_comp_ratio"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="0.18"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 手动翻袋库数 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="手动翻袋库数"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seek_bank_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="5"
                android:progress="2"
                android:progressTint="#FFD4A017" />

            <TextView
                android:id="@+id/tv_bank_count"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 辅助线粗细 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="辅助线粗细"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seek_line_thickness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="5"
                android:progressTint="#FFD4A017" />

            <TextView
                android:id="@+id/tv_line_thickness"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="5.0"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="显示蚂蚁线"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_ant_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#FFD4A017"
                android:trackTint="#666666" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="吸附最近球"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_adsorb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="#FFD4A017"
                android:trackTint="#666666"
                android:checked="true" />
        </LinearLayout>

        <!-- 退出按钮 -->
        <Button
            android:id="@+id/btn_exit_app"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:background="#CC3333"
            android:text="退出应用"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
