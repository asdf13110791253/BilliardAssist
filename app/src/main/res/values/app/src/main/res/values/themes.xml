<resources>
    <!-- 继承基础主题，并覆盖所有元素颜色为我们的粉色 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- 顶部状态栏和主色调 -->
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorPrimaryDark">@color/pink_primary</item>
        <item name="colorAccent">@color/pink_primary</item>
        <!-- 全局背景色 -->
        <item name="android:windowBackground">@color/pink_primary_light</item>
        <!-- 让标题栏也变成粉色 -->
        <item name="android:actionBarStyle">@style/Widget.AppCompat.ActionBar.Solid</item>
    </style>
</resources>
